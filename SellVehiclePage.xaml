<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGET.App.SellVehiclePage"
    BackgroundColor="#111111"
    Title="Sell Your Car">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- PAGE HEADER -->
            <Label
                Text="Sell Your Car"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="Create a listing and reach buyers across Ghana."
                FontSize="15"
                TextColor="#BBBBBB" />

            <!-- VEHICLE INFORMATION -->
            <Label
                Text="Vehicle Information"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="White"
                Margin="0,8,0,0" />

            <!-- BRAND -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Brand"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="BrandEntry"
                    Placeholder="e.g. Toyota"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <!-- MODEL -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Model"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="ModelEntry"
                    Placeholder="e.g. Corolla"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <!-- YEAR -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Year"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="YearEntry"
                    Placeholder="e.g. 2020"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    Keyboard="Numeric"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <!-- PRICE -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Price (GH₵)"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="PriceEntry"
                    Placeholder="e.g. 185000"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    Keyboard="Numeric"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <!-- MILEAGE -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Mileage (km)"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="MileageEntry"
                    Placeholder="e.g. 65000"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    Keyboard="Numeric"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <!-- FUEL -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Fuel Type"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Picker
                    x:Name="FuelPicker"
                    Title="Select fuel type"
                    TextColor="#111111"
                    BackgroundColor="White">

                    <Picker.Items>
                        <x:String>Petrol</x:String>
                        <x:String>Diesel</x:String>
                        <x:String>Hybrid</x:String>
                        <x:String>Electric</x:String>
                    </Picker.Items>

                </Picker>

            </VerticalStackLayout>

            <!-- TRANSMISSION -->
            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Transmission"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Picker
                    x:Name="TransmissionPicker"
                    Title="Select transmission"
                    TextColor="#111111"
                    BackgroundColor="White">

                    <Picker.Items>
                        <x:String>Automatic</x:String>
                        <x:String>Manual</x:String>
                    </Picker.Items>

                </Picker>

            </VerticalStackLayout>

            <!-- LOCATION -->
            <Label
                Text="Location"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="White"
                Margin="0,8,0,0" />

            <VerticalStackLayout Spacing="6">

                <Label
                    Text="City"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="CityEntry"
                    Placeholder="e.g. Accra"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">

                <Label
                    Text="Region"
                    FontSize="14"
                    TextColor="#BBBBBB" />

                <Entry
                    x:Name="RegionEntry"
                    Placeholder="e.g. Greater Accra"
                    PlaceholderColor="#777777"
                    TextColor="#111111"
                    BackgroundColor="White" />

            </VerticalStackLayout>

            <!-- DESCRIPTION -->
            <Label
                Text="Description"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="White"
                Margin="0,8,0,0" />

            <Editor
                x:Name="DescriptionEditor"
                Placeholder="Describe the condition, features and other details of the vehicle..."
                PlaceholderColor="#777777"
                TextColor="#111111"
                BackgroundColor="White"
                HeightRequest="130" />

            <!-- PHOTOS -->
            <Label
                Text="Vehicle Photos"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="White"
                Margin="0,8,0,0" />

            <Border
    BackgroundColor="#1F1F1F"
    Stroke="#F6C800"
    StrokeThickness="1"
    StrokeShape="RoundRectangle 14"
    Padding="20">

                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddPhotosTapped" />
                </Border.GestureRecognizers>

                <VerticalStackLayout
        Spacing="10"
        HorizontalOptions="Center">

                    <Label
                        Text="＋"
                        FontSize="38"
                        TextColor="#F6C800"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Add vehicle photos"
                        FontSize="16"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Add clear photos of your vehicle"
                        FontSize="13"
                        TextColor="#BBBBBB"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>
            <ScrollView
    Orientation="Horizontal"
    HorizontalScrollBarVisibility="Never">

                <HorizontalStackLayout
        x:Name="PhotoPreviewLayout"
        Spacing="10"
        HorizontalOptions="Start" />

            </ScrollView>

            <!-- SUBMIT -->
            <Button
                Text="Create Vehicle Listing"
                HeightRequest="55"
                BackgroundColor="#F6C800"
                TextColor="#111111"
                FontAttributes="Bold"
                FontSize="16"
                CornerRadius="12"
                Margin="0,10,0,30" 
                Clicked="OnCreateVehicleListingClicked" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGET.App.VehicleDetailsPage"
    BackgroundColor="#111111"
    Title="Vehicle Details">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- VEHICLE PHOTO GALLERY -->
            <Border
                BackgroundColor="#1F1F1F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16">

                <VerticalStackLayout Spacing="0">

                    <!-- MAIN VEHICLE PHOTO -->
                    <Image
                        x:Name="VehicleImage"
                        Source="corolla1.png"
                        HeightRequest="280"
                        Aspect="AspectFill" />

                    <!-- PHOTO COUNTER AND NAVIGATION -->
                    <Grid
                        Padding="10"
                        ColumnDefinitions="Auto,*,Auto"
                        BackgroundColor="#1F1F1F">

                        <Button
                            x:Name="PreviousPhotoButton"
                            Text="❮ Previous"
                            FontSize="12"
                            BackgroundColor="#333333"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="8,5"
                            Clicked="OnPreviousPhotoClicked" />

                        <Label
                            x:Name="PhotoCounterLabel"
                            Grid.Column="1"
                            Text="1 of 1"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="#F7C900"
                            HorizontalTextAlignment="Center"
                            VerticalTextAlignment="Center" />

                        <Button
                            x:Name="NextPhotoButton"
                            Grid.Column="2"
                            Text="Next ❯"
                            FontSize="12"
                            BackgroundColor="#333333"
                            TextColor="White"
                            CornerRadius="8"
                            Padding="8,5"
                            Clicked="OnNextPhotoClicked" />

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- VEHICLE NAME -->
            <Label
                x:Name="VehicleNameLabel"
                Text="2020 Toyota Corolla"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <!-- PRICE -->
            <Label
                x:Name="VehiclePriceLabel"
                Text="GH₵ 185,000"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="#F7C900" />

            <!-- VEHICLE INFORMATION -->
            <Border
                BackgroundColor="#1F1F1F"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                Padding="15">

                <Grid
                    ColumnDefinitions="*,*"
                    RowDefinitions="Auto,Auto,Auto"
                    RowSpacing="15">

                    <VerticalStackLayout>
                        <Label
                            Text="Year"
                            FontSize="13"
                            TextColor="#999999" />

                        <Label
                            x:Name="VehicleYearLabel"
                            Text="2020"
                            FontSize="16"
                            TextColor="White"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1">

                        <Label
                            Text="Mileage"
                            FontSize="13"
                            TextColor="#999999" />

                        <Label
                            x:Name="VehicleMileageLabel"
                            Text="65,000 km"
                            FontSize="16"
                            TextColor="White"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="1">

                        <Label
                            Text="Fuel"
                            FontSize="13"
                            TextColor="#999999" />

                        <Label
                            x:Name="VehicleFuelLabel"
                            Text="Petrol"
                            FontSize="16"
                            TextColor="White"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="1"
                        Grid.Column="1">

                        <Label
                            Text="Transmission"
                            FontSize="13"
                            TextColor="#999999" />

                        <Label
                            x:Name="VehicleTransmissionLabel"
                            Text="Automatic"
                            FontSize="16"
                            TextColor="White"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Row="2">

                        <Label
                            Text="Location"
                            FontSize="13"
                            TextColor="#999999" />

                        <Label
                            x:Name="VehicleLocationLabel"
                            Text="Accra, Greater Accra"
                            FontSize="16"
                            TextColor="White"
                            FontAttributes="Bold" />
                    </VerticalStackLayout>

                </Grid>

            </Border>

            <!-- DESCRIPTION -->
            <Label
                Text="Description"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                x:Name="VehicleDescriptionLabel"
                Text="Well maintained Toyota Corolla available for sale. Contact the seller for more information and viewing arrangements."
                FontSize="15"
                LineHeight="1.4"
                TextColor="#BBBBBB" />

            <!-- BUYER ACTION BUTTONS -->
            <Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12"
    Margin="0,5,0,0">

                <Button
        Text="♡ Save"
        BackgroundColor="#222222"
        TextColor="White"
        CornerRadius="12"
        HeightRequest="52"
        Clicked="OnSaveFavouriteClicked" />

                <Button
        Grid.Column="1"
        Text="Contact Seller"
        BackgroundColor="#F7C900"
        TextColor="#111111"
        FontAttributes="Bold"
        CornerRadius="12"
        HeightRequest="52"
        Clicked="OnContactSellerClicked" />

            </Grid>

            <!-- SELLER MANAGEMENT BUTTONS -->
            <Grid
    ColumnDefinitions="*,*"
    ColumnSpacing="12"
    Margin="0,0,0,20">

                <Button
        Text="✏️ Edit Listing"
        BackgroundColor="#333333"
        TextColor="White"
        FontAttributes="Bold"
        CornerRadius="12"
        HeightRequest="48"
        Clicked="OnEditListingClicked" />

                <Button
        Grid.Column="1"
        Text="🗑️ Delete Listing"
        BackgroundColor="#8B0000"
        TextColor="White"
        FontAttributes="Bold"
        CornerRadius="12"
        HeightRequest="48"
        Clicked="OnDeleteListingClicked" />

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
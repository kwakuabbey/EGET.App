<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EGET.App.BrowsePage"
    BackgroundColor="#111111"
    Title="Browse Cars">

    <Grid RowDefinitions="Auto,*">

        <!-- PAGE HEADER -->
        <VerticalStackLayout
            Grid.Row="0"
            Padding="20,16,20,10"
            Spacing="5">

            <Label
                Text="Browse Vehicles"
                FontSize="28"
                FontAttributes="Bold"
                TextColor="White" />

            <Label
                Text="Find your next car"
                FontSize="15"
                TextColor="#BBBBBB" />

        </VerticalStackLayout>

        <!-- SEARCH, FILTERS AND RESULTS -->
        <ScrollView
            Grid.Row="1">

            <VerticalStackLayout
                Padding="20,10,20,24"
                Spacing="16">

                <!-- SEARCH BOX -->
                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    Padding="12">

                    <Grid
                        ColumnDefinitions="Auto,*"
                        ColumnSpacing="10">

                        <Label
                            Text="🔍"
                            FontSize="20"
                            VerticalOptions="Center" />

                        <Entry
                            x:Name="SearchEntry"
                            Grid.Column="1"
                            Placeholder="Search brand, model or year"
                            PlaceholderColor="#777777"
                            TextColor="#111111"
                            BackgroundColor="Transparent"
                            ClearButtonVisibility="WhileEditing"
                            TextChanged="OnSearchTextChanged" />

                    </Grid>

                </Border>

                <!-- BRAND AND YEAR FILTERS -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Brand"
                            TextColor="#BBBBBB"
                            FontSize="13" />

                        <Border
                            BackgroundColor="#222222"
                            Stroke="#444444"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2">

                            <Picker
                                x:Name="BrandPicker"
                                Title="All brands"
                                TextColor="White"
                                TitleColor="#BBBBBB"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnFilterChanged" />

                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Year"
                            TextColor="#BBBBBB"
                            FontSize="13" />

                        <Border
                            BackgroundColor="#222222"
                            Stroke="#444444"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2">

                            <Picker
                                x:Name="YearPicker"
                                Title="All years"
                                TextColor="White"
                                TitleColor="#BBBBBB"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnFilterChanged" />

                        </Border>

                    </VerticalStackLayout>

                </Grid>

                <!-- PRICE FILTERS -->
                <VerticalStackLayout Spacing="8">

                    <Label
                        Text="Price Range (GH₵)"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="12">

                        <Border
                            BackgroundColor="#222222"
                            Stroke="#444444"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2">

                            <Entry
                                x:Name="MinimumPriceEntry"
                                Placeholder="Minimum price"
                                PlaceholderColor="#888888"
                                TextColor="White"
                                Keyboard="Numeric"
                                BackgroundColor="Transparent"
                                TextChanged="OnPriceChanged" />

                        </Border>

                        <Border
                            Grid.Column="1"
                            BackgroundColor="#222222"
                            Stroke="#444444"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2">

                            <Entry
                                x:Name="MaximumPriceEntry"
                                Placeholder="Maximum price"
                                PlaceholderColor="#888888"
                                TextColor="White"
                                Keyboard="Numeric"
                                BackgroundColor="Transparent"
                                TextChanged="OnPriceChanged" />

                        </Border>

                    </Grid>

                </VerticalStackLayout>

                <!-- LOCATION FILTER -->
                <VerticalStackLayout Spacing="6">

                    <Label
                        Text="Location"
                        TextColor="#BBBBBB"
                        FontSize="13" />

                    <Border
                        BackgroundColor="#222222"
                        Stroke="#444444"
                        StrokeShape="RoundRectangle 10"
                        Padding="10,2">

                        <Entry
                            x:Name="LocationEntry"
                            Placeholder="Enter city or region"
                            PlaceholderColor="#888888"
                            TextColor="White"
                            BackgroundColor="Transparent"
                            TextChanged="OnFilterChanged" />

                    </Border>

                </VerticalStackLayout>

                <!-- FUEL AND TRANSMISSION -->
                <Grid
                    ColumnDefinitions="*,*"
                    ColumnSpacing="12">

                    <VerticalStackLayout Spacing="6">

                        <Label
                            Text="Fuel Type"
                            TextColor="#BBBBBB"
                            FontSize="13" />

                        <Border
                            BackgroundColor="#222222"
                            Stroke="#444444"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2">

                            <Picker
                                x:Name="FuelPicker"
                                Title="All fuel types"
                                TextColor="White"
                                TitleColor="#BBBBBB"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnFilterChanged" />

                        </Border>

                    </VerticalStackLayout>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="6">

                        <Label
                            Text="Transmission"
                            TextColor="#BBBBBB"
                            FontSize="13" />

                        <Border
                            BackgroundColor="#222222"
                            Stroke="#444444"
                            StrokeShape="RoundRectangle 10"
                            Padding="10,2">

                            <Picker
                                x:Name="TransmissionPicker"
                                Title="All transmissions"
                                TextColor="White"
                                TitleColor="#BBBBBB"
                                BackgroundColor="Transparent"
                                SelectedIndexChanged="OnFilterChanged" />

                        </Border>

                    </VerticalStackLayout>

                </Grid>

                <!-- RESET FILTERS -->
                <Button
                    Text="Clear All Filters"
                    BackgroundColor="#333333"
                    TextColor="White"
                    BorderColor="#555555"
                    BorderWidth="1"
                    CornerRadius="10"
                    Clicked="OnClearFiltersClicked" />

                <!-- RESULTS HEADING -->
                <VerticalStackLayout Spacing="10" Margin="0,8,0,0">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
            Text="Available Vehicles"
            FontSize="21"
            FontAttributes="Bold"
            TextColor="White"
            VerticalOptions="Center" />

                        <Label
            x:Name="ResultsCountLabel"
            Grid.Column="1"
            Text="0 cars"
            FontSize="13"
            TextColor="#F7C900"
            VerticalOptions="Center" />

                    </Grid>

                    <!-- SORT VEHICLES -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                        <Label
            Text="Sort by"
            FontSize="14"
            TextColor="#BBBBBB"
            VerticalOptions="Center" />

                        <Border
            Grid.Column="1"
            BackgroundColor="#222222"
            Stroke="#444444"
            StrokeShape="RoundRectangle 10"
            Padding="10,2">

                            <Picker
                x:Name="SortPicker"
                Title="Sort vehicles"
                TextColor="White"
                TitleColor="#BBBBBB"
                BackgroundColor="Transparent"
                SelectedIndexChanged="OnSortChanged" />

                        </Border>

                    </Grid>

                </VerticalStackLayout>

                <!-- EMPTY RESULTS MESSAGE -->
                <VerticalStackLayout
    x:Name="EmptyResultsLayout"
    IsVisible="False"
    Padding="20,30"
    Spacing="12">

                    <Label
        Text="🚗"
        FontSize="48"
        HorizontalOptions="Center" />

                    <Label
        x:Name="EmptyResultsTitle"
        Text="No matching vehicles"
        FontSize="21"
        FontAttributes="Bold"
        TextColor="White"
        HorizontalOptions="Center"
        HorizontalTextAlignment="Center" />

                    <Label
        x:Name="EmptyResultsMessage"
        Text="We couldn't find vehicles matching your search. Try another brand, model, location, or price range."
        FontSize="14"
        TextColor="#BBBBBB"
        HorizontalOptions="Center"
        HorizontalTextAlignment="Center" />

                    <Button
        Text="Clear Search and Filters"
        BackgroundColor="#F7C900"
        TextColor="#111111"
        FontAttributes="Bold"
        CornerRadius="10"
        HeightRequest="48"
        Clicked="OnClearFiltersClicked" />

                </VerticalStackLayout>

                <!-- DYNAMIC VEHICLE RESULTS -->
                <VerticalStackLayout
                    x:Name="VehicleResultsLayout"
                    Spacing="16" />

            </VerticalStackLayout>

        </ScrollView>

    </Grid>

</ContentPage>